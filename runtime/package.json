{
  "name": "amber-voice-bridge",
  "version": "5.5.45",
  "description": "Twilio + OpenAI Realtime SIP bridge for Amber Voice Assistant (OpenClaw skill)",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node setup-wizard.js",
    "dev": "tsx watch src/index.ts",
