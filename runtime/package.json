    "dotenv": "16.6.1",
    "express": "4.22.2",
    "openai": "4.104.0",
    "twilio": "5.12.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/body-parser": "1.19.6",
    "@types/express": "4.17.25",
    "@types/node": "22.19.11",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
