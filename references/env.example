# Amber Voice Assistant - Environment Configuration
# Copy to .env and configure with your values.

# === Telephony Provider ===
# Which telephony provider to use. Default: twilio (production-ready).
# Options: twilio | telnyx (stub — see runtime/src/providers/telnyx.ts to implement)
# Telnyx is ~40-60% cheaper than Twilio with a nearly identical API surface.
VOICE_PROVIDER=twilio

# === Required: Twilio Configuration (VOICE_PROVIDER=twilio, the default) ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_CALLER_ID=+15555551234

# === Optional: Provider-agnostic overrides ===
# These override the Twilio-specific defaults when switching providers.
# VOICE_CALLER_ID=+15555551234         # outbound caller ID (any provider)
# VOICE_WEBHOOK_SECRET=                # webhook signing secret (your provider's auth secret)

# === Optional: Telnyx Configuration (VOICE_PROVIDER=telnyx — not yet implemented) ===
# TELNYX_API_KEY=KEY...
# TELNYX_SIP_CONNECTION_ID=sipcon_xxxxx

# === Required: OpenAI Configuration ===
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_PROJECT_ID=proj_xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_VOICE=alloy

# === Required: Server Configuration ===
PORT=8000
PUBLIC_BASE_URL=https://your-bridge-domain.com

# === Optional: OpenClaw Gateway (for brain-in-loop features) ===
# If you have an OpenClaw gateway, the bridge can delegate complex queries to it
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your_openclaw_token

# === Optional: Assistant & Operator Personalization ===
# Customize the assistant's identity and operator information
ASSISTANT_NAME=Amber
OPERATOR_NAME=your operator
OPERATOR_PHONE=+15555551234
OPERATOR_EMAIL=operator@example.com
ORG_NAME=
DEFAULT_CALENDAR=

# === Optional: Call Screening Customization ===
# Comma-separated E.164 phone numbers that should get GenZ-style screening
# Example: +14165551234,+14165555678
GENZ_CALLER_NUMBERS=

# === Optional: Data Persistence ===
# Path where outbound call metadata is stored
# Defaults to ./data/bridge-outbound-map.json if not set
OUTBOUND_MAP_PATH=
